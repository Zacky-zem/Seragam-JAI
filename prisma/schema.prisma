generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String    @id @default(cuid())
  username              String    @unique
  email                 String?   @unique
  passwordHash          String
  name                  String
  resetPasswordToken    String?   @unique
  resetPasswordExpires  DateTime?
  createdAt             DateTime  @default(now())
}

model UniformRecord {
  id                String    @id @default(cuid())
  noPR              String?   @unique
  namaKaryawan      String
  nip               String?
  departemen        String
  section           String?
  ukuranBaju        String
  ukuranCelana      String?
  jumlah            Int       @default(1)
  tanggalPengajuan  DateTime?
  tanggalPenerimaan DateTime?
  status            String    @default("Diajukan")
  batch             String?
  keterangan        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([namaKaryawan])
  @@index([departemen])
  @@index([status])
  @@index([tanggalPengajuan])
}
